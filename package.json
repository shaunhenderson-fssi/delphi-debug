{
  "name": "delphi-debug",
  "displayName": "delphi-debug",
  "description": "Delphi debugger for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "delphi-debug.delphiDebug",
        "title": "Delphi Debug"
      },
      {
        "command": "delphi-debug.currentLineInfo",
        "title": "Delphi Debug: Current line info"
      },
      {
        "command": "delphi-debug.selectMapFile",
        "title": "Delphi Debug: Select MAP file"
      },
      {
        "command": "delphi-debug.goToRuntimeAddress",
        "title": "Delphi Debug: Go To Runtime Address"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src/**/*.ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
